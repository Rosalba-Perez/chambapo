# Copia este archivo como .env y llénalo. Nunca subas el .env a Git.
DJANGO_SECRET_KEY=cambiar
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=api.chambapo.co,localhost
# Lo encuentras en Supabase > Project Settings > Database > Connection string
DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-us-east-1.pooler.supabase.com:5432/postgres
# Lo encuentras en Supabase > Project Settings > API
SUPABASE_URL=https://xxxx.supabase.co
# Normalmente se deja vacío
SUPABASE_JWT_SECRET=
SUPABASE_SERVICE_KEY=cambiar
# El archivo JSON lo descargas en Firebase > Project settings > Service accounts
FIREBASE_CREDENTIALS=/app/firebase.json
# Nombre con el que la app usa el servicio de mapas
NOMINATIM_USER_AGENT=chambapo-proyecto-aula

# ---- Panel web ----
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=cambiar
VITE_API_URL=https://api.chambapo.co

# ---- Kubernetes / EKS ----
# Pon 1 si lo despliegas en EKS
CORS_ALLOW_ALL=0
CORS_ALLOWED_ORIGINS=http://localhost:5173
